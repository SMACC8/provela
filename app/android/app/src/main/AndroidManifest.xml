<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- La veglia d'ancora a schermo spento. Tipo "location": col
             permesso "mentre usi l'app" continua a ricevere il GPS anche
             quando l'app va dietro, perche' parte da un tocco sulla pagina.
             Non esportato: lo avvia e lo ferma solo Dritta. -->
        <service
            android:name=".VegliaService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

    <!-- Permessi -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- La WebView chiede la posizione con navigator.geolocation, ma il
         permesso lo deve dichiarare l'applicazione: senza queste due righe
         il ponte di Capacitor chiede a Android un permesso che il manifesto
         non nomina, Android lo nega all'istante e alla pagina arriva un
         PERMISSION_DENIED senza che all'utente venga chiesto niente.
         Visto sul tablet il 21/09/2026: nessun aggancio, nessuna domanda. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Dichiarare ACCESS_FINE_LOCATION fa presumere al Play Store che il
         ricevitore GPS sia OBBLIGATORIO, e lo nasconderebbe ai tablet senza.
         required="false" dice il contrario: Dritta lo usa se c'e', e senza
         funziona lo stesso (meteo, carte, manutenzione, prontuario). -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Veglia d'ancora (VegliaService).
         FOREGROUND_SERVICE e _LOCATION: il servizio che tiene il GPS a
         schermo spento; da Android 14 il tipo va dichiarato anche qui.
         WAKE_LOCK: senza, fra un fix e l'altro la CPU dorme e il controllo
         "GPS fermo da tre minuti" non girerebbe mai.
         POST_NOTIFICATIONS: da Android 13 si chiede a video; la veglia
         funziona anche senza, ma la notifica d'allarme non si vede.
         USE_FULL_SCREEN_INTENT: l'allarme accende lo schermo, come una
         sveglia. VIBRATE: la vibrazione in loop durante l'allarme.
         NON c'e' ACCESS_BACKGROUND_LOCATION, di proposito: vedi
         VegliaService, non serve e costringerebbe a un giro nelle
         impostazioni di sistema. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
